{
  "name": "iim-bound",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "An open-source daily register for CAT preparation: drills, mocks, syllabus coverage and focus time.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check src scripts next.config.ts tests",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write src scripts next.config.ts tests",
    "check": "npm run lint && npm run typecheck && npm test",
    "test": "node --experimental-strip-types src/lib/cat.test.ts && node --experimental-strip-types --import ./tests/resolver-loader.mjs --test tests/helpers.test.mjs",
    "test:up": "supabase start",
    "test:down": "supabase stop",
    "test:e2e": "./tests/e2e/run.sh",
    "test:browser": "./tests/browser/run.sh",
    "test:all": "npm run check && npm run test:e2e && npm run test:browser",
    "db:push": "supabase db push --linked",
    "db:migrate": "node scripts/apply-migration.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
