# Supabase project settings → API. Both values are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Clerk → API keys. The publishable key is safe in the browser; the secret key
# is server-only and must never be prefixed with NEXT_PUBLIC_.
# `npx clerk env pull` writes both of these into .env.local for you.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Optional: shown as the "Source" link in the footer.
# NEXT_PUBLIC_REPO_URL=https://github.com/unhingedpanda/iim-bound
